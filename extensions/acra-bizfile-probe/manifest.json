{
  "manifest_version": 3,
  "name": "OakCloud Bizfile Input Probe (POC)",
  "version": "0.1.0",
  "description": "Proof of concept: tests whether Bizfile form controls keep values filled by an extension. Never submits, declares or pays.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "scripting", "storage"],
  "host_permissions": ["https://*.bizfile.gov.sg/*"],
  "background": { "service_worker": "src/background.js" },
  "action": { "default_title": "Open the Bizfile input probe" },
  "side_panel": { "default_path": "src/sidepanel.html" },
  "content_scripts": [
    {
      "matches": ["https://*.bizfile.gov.sg/*"],
      "js": ["src/page-signals.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": ["https://*.bizfile.gov.sg/*"],
      "js": ["src/probe-core.js", "src/content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
